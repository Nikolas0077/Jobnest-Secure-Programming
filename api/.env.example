# Copy this file to api/.env and fill in your own values. Never commit api/.env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jobnest
DB_USER=jobnest_app
DB_PASS=

# Set to 1 when the site is served over HTTPS (adds the Secure flag to cookies).
COOKIE_SECURE=0

# IP of the PHP UI server that calls this API. Only these may send X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Optional: custom private folder for CV files (must be outside public/).
# JOBNEST_STORAGE_DIR=
